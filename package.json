{
  "name": "quizparty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:build": "vite build && electron-builder --win",
    "electron:dev": "vite build && electron ."
  },
  "build": {
    "appId": "com.quizparty.app",
    "productName": "QuizParty",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
